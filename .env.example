# LLM provider (currently: groq)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key
# LLM_TEMPERATURE=0.1

# Filesystem sandbox: tools may only touch paths below these roots
# (separated by ':'). Default: your home directory and the current directory.
# PC_AGENT_ALLOWED_PATHS=/home/you/Downloads:/home/you/Documents

# Opt-in tools (also available as --allow-destructive / --allow-python)
# PC_AGENT_ALLOW_DESTRUCTIVE=false
# PC_AGENT_ALLOW_PYTHON=false

# PC_AGENT_LOG_DIR=logs
# PC_AGENT_MAX_STEPS=20
